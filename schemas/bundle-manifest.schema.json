{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/bundle-manifest-0.1.0.schema.json",
  "title": "ISV Readiness Qualification Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "assessment_mode", "outcome", "validation", "domains", "provider_files", "files", "excluded_sensitive"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "provider": {"type": "string"},
    "assessment_mode": {"enum": ["qualification", "full_validation"]},
    "outcome": {"enum": ["qualification_complete", "validation_complete", "incomplete"]},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "ref", "pinned_commit", "current_commit"],
      "properties": {
        "url": {"type": "string"},
        "ref": {"type": "string"},
        "pinned_commit": {"type": ["string", "null"]},
        "current_commit": {"type": "string"}
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "status", "reason"],
        "properties": {
          "domain": {"type": "string"},
          "status": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "provider_files": {"type": "array", "items": {"$ref": "#/$defs/file_hash"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file_hash"}},
    "excluded_sensitive": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "file_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "size"],
      "properties": {
        "path": {"type": "string"},
        "kind": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
