{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/application-result-0.1.0.schema.json",
  "title": "ISV Readiness Controlled Application Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gap_id",
    "target",
    "patch_sha256",
    "target_before_sha256",
    "target_after_sha256",
    "backup_path",
    "applied"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "gap_id": {"type": "string", "pattern": "^gap_[0-9a-f]{12}$"},
    "target": {"type": "string", "pattern": "^scripts/"},
    "patch_sha256": {"$ref": "#/$defs/hash"},
    "target_before_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/hash"},
        {"type": "null"}
      ]
    },
    "target_after_sha256": {"$ref": "#/$defs/hash"},
    "backup_path": {"type": ["string", "null"]},
    "applied": {"const": true}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
