{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/change-proposal-0.1.0.schema.json",
  "title": "ISV Readiness Guarded Multi-file Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gap_id", "domain", "change_set_sha256", "patch_sha256", "patch", "files"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "gap_id": {"type": "string"},
    "domain": {"type": "string"},
    "change_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "patch": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "file": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_root", "path", "operation", "before_sha256", "after_sha256"],
        "properties": {
          "target_root": {"enum": ["provider", "providers"]},
          "path": {"type": "string"},
          "operation": {"enum": ["create", "replace"]},
          "before_sha256": {"type": ["string", "null"]},
          "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
}
