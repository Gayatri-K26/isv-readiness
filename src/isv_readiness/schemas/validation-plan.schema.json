{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/validation-plan-0.1.0.schema.json",
  "title": "ISV Readiness Normalized Validation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "config_version",
    "catalog_version",
    "isvctl_version",
    "platform",
    "config_files",
    "config_fingerprint",
    "catalog_fingerprint",
    "features",
    "steps",
    "validations",
    "warnings",
    "metadata"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "config_version": {
      "$ref": "#/$defs/nullable_string"
    },
    "catalog_version": {
      "$ref": "#/$defs/nullable_string"
    },
    "isvctl_version": {
      "$ref": "#/$defs/nullable_string"
    },
    "platform": {
      "$ref": "#/$defs/nullable_string"
    },
    "config_files": {
      "$ref": "#/$defs/string_array"
    },
    "config_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "catalog_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "features": {
      "$ref": "#/$defs/string_array"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "warnings": {
      "$ref": "#/$defs/string_array"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "nullable_string": {
      "type": ["string", "null"]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "name",
        "phase",
        "command",
        "skipped",
        "valid",
        "error",
        "metadata"
      ],
      "properties": {
        "platform": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/nullable_string"
        },
        "command": {
          "$ref": "#/$defs/nullable_string"
        },
        "skipped": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/nullable_string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "base_name",
        "category",
        "step",
        "phase",
        "params",
        "labels",
        "platforms",
        "description",
        "module",
        "known_to_catalog",
        "valid",
        "error",
        "execution_adapter",
        "metadata"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "base_name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "step": {
          "$ref": "#/$defs/nullable_string"
        },
        "phase": {
          "type": "string"
        },
        "params": {},
        "labels": {
          "$ref": "#/$defs/string_array"
        },
        "platforms": {
          "$ref": "#/$defs/string_array"
        },
        "description": {
          "$ref": "#/$defs/nullable_string"
        },
        "module": {
          "$ref": "#/$defs/nullable_string"
        },
        "known_to_catalog": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/nullable_string"
        },
        "execution_adapter": {
          "$ref": "#/$defs/nullable_string"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
