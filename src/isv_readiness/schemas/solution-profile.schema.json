{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/solution-profile-0.1.0.schema.json",
  "title": "ISV Readiness Solution Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "solution",
    "journey",
    "actors",
    "components",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "solution": {
      "$ref": "#/$defs/solution"
    },
    "journey": {
      "$ref": "#/$defs/journey"
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain"
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "coverage": {
      "enum": ["covered", "gap", "out_of_scope", "unknown"]
    },
    "validation_mode": {
      "enum": ["test", "evidence", "skip", "deferred"]
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "vendor",
        "version",
        "profile_status",
        "target_environment"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "profile_status": {
          "enum": ["draft", "reviewed", "confirmed"]
        },
        "target_environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status"],
      "properties": {
        "stage": {
          "enum": ["qualify", "validate"]
        },
        "status": {
          "enum": ["not_started", "in_progress", "blocked", "ready", "complete"]
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["isv", "nvidia", "ncp", "customer", "partner", "lab", "other"]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "kind",
        "supplier_actor_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["product", "service", "integration", "external_dependency"]
        },
        "supplier_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "nsrg_layers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "depends_on": {
          "$ref": "#/$defs/string_array"
        },
        "source_refs": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "validation_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "validation_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "selectors"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "selectors": {
          "$ref": "#/$defs/selectors"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "validation_mode": {
          "$ref": "#/$defs/validation_mode"
        },
        "capability_owner_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "provider_adapter_owner_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "component_ids": {
          "$ref": "#/$defs/string_array"
        },
        "rationale": {
          "type": "string"
        },
        "required_inputs": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "name",
        "coverage",
        "validation_mode",
        "capability_owner_actor_id",
        "provider_adapter_owner_actor_id"
      ],
      "properties": {
        "domain": {
          "enum": [
            "bare_metal",
            "control_plane",
            "iam",
            "image_registry",
            "kubernetes",
            "network",
            "observability",
            "security",
            "slurm",
            "storage",
            "vm"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owned": {
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "validation_mode": {
          "$ref": "#/$defs/validation_mode"
        },
        "capability_owner_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "provider_adapter_owner_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "component_ids": {
          "$ref": "#/$defs/string_array"
        },
        "provider_configs": {
          "$ref": "#/$defs/string_array"
        },
        "rationale": {
          "type": "string"
        },
        "required_inputs": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "default": []
        }
      }
    }
  }
}
