{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/agent-state-0.1.0.schema.json",
  "title": "ISV Readiness Agent Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_sha256", "domain", "status", "iteration", "attempts", "selected_gap_id", "patch_sha256", "reason", "artifacts", "feedback", "history"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "domain": {"type": "string"},
    "status": {"enum": ["ready", "awaiting_generator", "awaiting_review", "awaiting_live", "blocked", "complete"]},
    "iteration": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "selected_gap_id": {"type": ["string", "null"]},
    "patch_sha256": {"type": ["string", "null"]},
    "reason": {"type": "string"},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
    "feedback": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string"},
          {"$ref": "#/$defs/failure_feedback"}
        ]
      }
    },
    "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "gap_id", "reason"],
        "properties": {
          "status": {"type": "string"},
          "gap_id": {"type": ["string", "null"]},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "failure_feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "category",
        "fingerprint",
        "summary",
        "expected",
        "actual",
        "stable_error",
        "representative_excerpt",
        "affected_checks",
        "affected_count",
        "artifact_refs",
        "details",
        "retryable",
        "retry_reason"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "category": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "summary": {"type": "string"},
        "expected": {"type": "string"},
        "actual": {"type": "string"},
        "stable_error": {"type": "string"},
        "representative_excerpt": {"type": "string"},
        "affected_checks": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "affected_count": {"type": "integer", "minimum": 0},
        "artifact_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_reference"}
        },
        "details": {
          "type": "array",
          "items": {"type": "string"}
        },
        "retryable": {"type": "boolean"},
        "retry_reason": {"type": "string"}
      }
    }
  }
}
