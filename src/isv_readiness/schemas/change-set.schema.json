{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/change-set-0.1.0.schema.json",
  "title": "ISV Readiness Generated Change Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gap_id", "context_pack_sha256", "generator", "summary", "changes"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "gap_id": {"type": "string", "pattern": "^gap_[0-9a-f]{12}$"},
    "context_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]}
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "changes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_root", "path", "operation", "content", "content_sha256", "rationale"],
        "properties": {
          "target_root": {"enum": ["provider", "providers"]},
          "path": {"type": "string", "minLength": 1},
          "operation": {"enum": ["create", "replace"]},
          "content": {"type": "string"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  }
}
