{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/domain-audit-0.1.0.schema.json",
  "title": "ISV Readiness Domain Completeness Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "audit_context_sha256", "auditor", "summary", "capabilities"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "domain": {"type": "string", "minLength": 1},
    "audit_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]}
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "path", "detail"],
      "properties": {
        "effect": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "status",
        "step_name",
        "target",
        "expected_effects",
        "implementation_evidence",
        "reason"
      ],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["implemented", "gap", "scope_question"]},
        "step_name": {"type": "string", "minLength": 1},
        "target": {"type": ["string", "null"]},
        "expected_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup", "test", "teardown"],
          "properties": {
            "setup": {"$ref": "#/$defs/string_array"},
            "test": {"$ref": "#/$defs/string_array"},
            "teardown": {"$ref": "#/$defs/string_array"}
          }
        },
        "implementation_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
