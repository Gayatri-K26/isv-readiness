{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/isv-readiness/live-run-0.1.0.schema.json",
  "title": "ISV Readiness Targeted Live Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "config", "selection", "command", "exit_code", "junit_path", "log_path", "selected_statuses", "success", "report"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "domain": {"type": "string"},
    "config": {"type": "string"},
    "selection": {"type": ["string", "null"]},
    "command": {"type": "array", "items": {"type": "string"}},
    "exit_code": {"type": "integer"},
    "junit_path": {"type": ["string", "null"]},
    "log_path": {"type": "string"},
    "selected_statuses": {"type": "array", "items": {"type": "string"}},
    "success": {"type": "boolean"},
    "report": {"type": "object"}
  }
}
