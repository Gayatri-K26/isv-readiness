{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gapctl live-run check explanations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "artifacts", "checks"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "provider",
        "domain",
        "validation_commit",
        "solution_profile_sha256",
        "source_report_sha256",
        "exit_code",
        "success"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "validation_commit": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "null"}
          ]
        },
        "solution_profile_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "source_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
        "success": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["junit", "log"],
      "properties": {
        "junit": {"$ref": "#/$defs/artifact"},
        "log": {"$ref": "#/$defs/artifact"}
      }
    },
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "artifact": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        {"type": "null"}
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched",
        "owned",
        "capability_id",
        "coverage",
        "validation_mode",
        "action",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "matched": {"type": "boolean"},
        "owned": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
        "capability_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "coverage": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "validation_mode": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "action": {"type": "string", "minLength": 1},
        "rationale": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "edit_eligible", "action", "reason"],
      "properties": {
        "blocking": {"type": "boolean"},
        "edit_eligible": {"type": "boolean"},
        "action": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "domain",
        "step_name",
        "validation_class",
        "requirement_id",
        "outcome",
        "source",
        "reason_code",
        "explanation",
        "validation_message",
        "junit_testcase",
        "scope",
        "decision"
      ],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "step_name": {"type": "string", "minLength": 1},
        "validation_class": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "requirement_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "outcome": {
          "enum": ["pass", "fail", "not_implemented", "skipped", "error"]
        },
        "source": {"enum": ["junit", "reviewed_scope"]},
        "reason_code": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "validation_message": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "junit_testcase": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "scope": {"$ref": "#/$defs/scope"},
        "decision": {"$ref": "#/$defs/decision"}
      }
    }
  }
}
